<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EcoRuta</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <header class="barra">
    <a class="marca" href="/">Eco<span>Ruta</span></a>
    <% if (usuario) { %>
      <nav>
        <a href="/viajes">Buscar viajes</a>
        <% if (usuario.rol === 'conductor') { %><a href="/viajes/nuevo">Publicar viaje</a><% } %>
        <% if (usuario.rol === 'pasajero') { %><a href="/mis-reservas">Mis reservas</a><% } %>
        <span class="quien"><%= usuario.nombre %> · <%= usuario.rol %></span>
        <form method="post" action="/logout"><button class="enlace" type="submit">Cerrar sesión</button></form>
      </nav>
    <% } %>
  </header>
  <main class="contenido">
    <% if (mensaje) { %>
      <div class="aviso <%= mensaje.tipo %>"><%= mensaje.texto %></div>
    <% } %>
