<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EcoRuta</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <header class="barra">
    <a class="marca" href="/">Eco<span>Ruta</span></a>
    <% if (usuario) { %>
      <nav>
        <span class="quien"><%= usuario.nombre %> · <%= usuario.rol %></span>
      </nav>
    <% } %>
  </header>
  <main class="contenido">
    <% if (mensaje) { %>
      <div class="aviso <%= mensaje.tipo %>"><%= mensaje.texto %></div>
    <% } %>
