<%- include('partials/cabecera') %>
<section class="tarjeta">
  <h1>Viajes próximos</h1>
  <p class="sub">Viajes publicados por compañeros de Tecsup, ordenados por hora de llegada.</p>
  <form class="filtros" method="get" action="/viajes">
    <label>Zona de salida
      <select name="zona">
        <option value="">Todas las zonas</option>
        <% zonas.forEach(function (z) { %>
          <option <%= filtro.zona === z ? 'selected' : '' %>><%= z %></option>
        <% }) %>
      </select>
    </label>
    <label>Necesito llegar a las
      <input type="time" name="llegar" value="<%= filtro.llegar %>">
    </label>
    <button type="submit">Filtrar</button>
    <% if (filtro.zona || filtro.llegar) { %><a class="muted" href="/viajes">Quitar filtros</a><% } %>
  </form>
</section>
<% if (viajes.length === 0) { %>
  <section class="tarjeta vacio">
    <% if (filtro.zona || filtro.llegar) { %>No hay viajes que coincidan con tu búsqueda.<% } else { %>Aún no hay viajes publicados<% } %>
  </section>
<% } %>
<div class="lista">
  <% viajes.forEach(function (v) { %>
    <article class="tarjeta viaje">
      <div class="viaje-cabeza">
        <h2><%= v.zona %> → Tecsup</h2>
        <% if (v.cupos_libres === 0) { %>
          <span class="chip lleno">Lleno</span>
        <% } else { %>
          <span class="chip"><%= v.cupos_libres %> de <%= v.cupos %> cupos libres</span>
        <% } %>
      </div>
      <p class="horas"><strong><%= v.fecha_texto %></strong> · Sale <%= v.salida %> · Llega <%= v.llegada %></p>
      <p class="muted">Conductor: <%= v.conductor %></p>
      <% if (usuario.rol === 'pasajero') { %>
        <% if (reservados.has(v.id)) { %>
          <span class="chip">Ya reservaste este viaje</span>
        <% } else if (v.cupos_libres > 0) { %>
          <form method="post" action="/viajes/<%= v.id %>/reservar"><button type="submit">Reservar</button></form>
        <% } %>
      <% } %>
    </article>
  <% }) %>
</div>
<%- include('partials/pie') %>
